{
  "name": "@xrpl-connect/react",
  "version": "1.0.0-rc.0",
  "description": "React bindings (provider, hooks, modal component) for XRPL Connect",
  "author": "XRPL Connect Contributors",
  "license": "MIT",
  "homepage": "https://github.com/XRPL-Commons/xrpl-connect#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XRPL-Commons/xrpl-connect.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/XRPL-Commons/xrpl-connect/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "rc"
  },
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || >=24.11.0"
  },
  "keywords": [
    "xrpl",
    "wallet",
    "react",
    "hooks",
    "provider",
    "web3",
    "wallet-connection",
    "xaman",
    "crossmark"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vp pack && node scripts/prepare-types.mjs",
    "dev": "vp pack --watch",
    "prepublishOnly": "node -e \"const { npm_config_tag: tag, npm_config_access: access, npm_config_registry: registry } = process.env; let registryUrl = ''; try { registryUrl = new URL(registry).href; } catch {} if (tag !== 'rc' || access !== 'public' || registryUrl !== 'https://registry.npmjs.org/') { console.error('Publish requires --tag rc --access public --registry https://registry.npmjs.org/'); process.exit(1); }\"",
    "lint": "vp lint src",
    "type-check": "tsc --noEmit",
    "test": "pnpm test:types && node tests/ssr-smoke.mjs && vp test run",
    "test:types": "tsc -p tests/tsconfig.types.json",
    "test:watch": "vp test",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "xrpl": "^3.0.0 || ^4.0.0",
    "xrpl-connect": "^1.0.0-rc.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.47.0",
    "@xrpl-connect/core": "workspace:*",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^22.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "xrpl-connect": "workspace:*"
  }
}
