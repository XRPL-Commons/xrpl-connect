{
  "name": "@xrpl-connect/adapter-crossmark",
  "version": "0.8.2",
  "description": "Crossmark wallet adapter for XRPL Connect - Browser extension wallet support",
  "author": "XRPL Connect Contributors",
  "license": "MIT",
  "homepage": "https://github.com/XRPL-Commons/xrpl-connect#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/XRPL-Commons/xrpl-connect",
    "directory": "packages/adapters/crossmark"
  },
  "bugs": {
    "url": "https://github.com/XRPL-Commons/xrpl-connect/issues"
  },
  "keywords": [
    "xrpl",
    "crossmark",
    "wallet",
    "adapter",
    "web3",
    "browser-extension"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vp pack && node scripts/prepare-types.mjs",
    "dev": "vp pack --watch",
    "test": "tsc --project tsconfig.test.json && vp test run",
    "test:watch": "vp test",
    "lint": "vp lint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@xrpl-connect/core": "workspace:*",
    "@crossmarkio/sdk": "^0.4.0",
    "@crossmarkio/typings": "0.0.6",
    "@types/chrome": "^0.0.253",
    "@types/node-forge": "^1.3.10"
  },
  "peerDependencies": {
    "xrpl": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
