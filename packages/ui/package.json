{
  "name": "@xrpl-connect/ui",
  "version": "0.8.2",
  "description": "Web component UI for XRPL Connect wallet connections",
  "author": "XRPL Connect Contributors",
  "license": "MIT",
  "homepage": "https://github.com/XRPL-Commons/xrpl-connect#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/XRPL-Commons/xrpl-connect",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/XRPL-Commons/xrpl-connect/issues"
  },
  "keywords": [
    "xrpl",
    "wallet",
    "web-component",
    "ui",
    "web3",
    "wallet-ui",
    "modal",
    "qr-code"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "lint": "vp lint src",
    "type-check": "tsc --noEmit",
    "test": "pnpm test:types && vp test run",
    "test:types": "tsc -p tests/tsconfig.types.json",
    "test:watch": "vp test",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@xrpl-connect/core": "^0.8.3"
  },
  "devDependencies": {
    "@xrpl-connect/core": "workspace:*",
    "typescript": "^5.3.3",
    "vite": "catalog:",
    "jsdom": "^22.1.0"
  },
  "dependencies": {
    "qr-code-styling": "^1.6.0-rc.1"
  }
}
